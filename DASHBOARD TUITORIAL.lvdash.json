{
  "datasets": [
    {
      "name": "d744d0a6",
      "displayName": "df_sales_db",
      "queryLines": [
        "WITH df_sales_db AS (\r\n",
        "    SELECT 101 AS sale_id, 'Kochi' AS city, 'Medicine' AS product_category, 1200 AS sales_amount\r\n",
        "UNION ALL\r\n",
        "SELECT 102, 'Kochi', 'Medicine', 1800\r\n",
        "UNION ALL\r\n",
        "SELECT 103, 'Kochi', 'Supplements', 2500\r\n",
        "UNION ALL\r\n",
        "SELECT 104, 'Kochi', 'Medical Devices', 4500\r\n",
        "UNION ALL\r\n",
        "SELECT 105, 'Chennai', 'Medicine', 1500\r\n",
        "UNION ALL\r\n",
        "SELECT 106, 'Chennai', 'Supplements', 2200\r\n",
        "UNION ALL\r\n",
        "SELECT 107, 'Chennai', 'Medical Devices', 5000\r\n",
        "UNION ALL\r\n",
        "SELECT 108, 'Chennai', 'Medicine', 1700\r\n",
        "UNION ALL\r\n",
        "SELECT 109, 'Bangalore', 'Medicine', 2100\r\n",
        "UNION ALL\r\n",
        "SELECT 110, 'Bangalore', 'Supplements', 2800\r\n",
        "UNION ALL\r\n",
        "SELECT 111, 'Bangalore', 'Medical Devices', 6000\r\n",
        "UNION ALL\r\n",
        "SELECT 112, 'Bangalore', 'Medicine', 2400\r\n",
        "UNION ALL\r\n",
        "SELECT 113, 'Hyderabad', 'Medicine', 1600\r\n",
        "UNION ALL\r\n",
        "SELECT 114, 'Hyderabad', 'Supplements', 2600\r\n",
        "UNION ALL\r\n",
        "SELECT 115, 'Hyderabad', 'Medical Devices', 5500\r\n",
        "UNION ALL\r\n",
        "SELECT 116, 'Hyderabad', 'Medicine', 1900\r\n",
        "UNION ALL\r\n",
        "SELECT 117, 'Delhi', 'Medicine', 2300\r\n",
        "UNION ALL\r\n",
        "SELECT 118, 'Delhi', 'Supplements', 3200\r\n",
        "UNION ALL\r\n",
        "SELECT 119, 'Delhi', 'Medical Devices', 7000\r\n",
        "UNION ALL\r\n",
        "SELECT 120, 'Delhi', 'Medicine', 2700\r\n",
        "UNION ALL\r\n",
        "SELECT 121, 'Kochi', 'Supplements', 2900\r\n",
        "UNION ALL\r\n",
        "SELECT 122, 'Chennai', 'Supplements', 3100\r\n",
        "UNION ALL\r\n",
        "SELECT 123, 'Bangalore', 'Medicine', 2600\r\n",
        "UNION ALL\r\n",
        "SELECT 124, 'Hyderabad', 'Medical Devices', 5800\r\n",
        "UNION ALL\r\n",
        "SELECT 125, 'Delhi', 'Supplements', 3400\r\n",
        ")\r\n",
        "SELECT * FROM df_sales_db;\r\n"
      ]
    },
    {
      "name": "84f54165",
      "displayName": "sales_17",
      "queryLines": [
        "WITH sales AS (\n",
        "    SELECT * FROM VALUES\n",
        "    ('Kochi', '2024-01', 120000),\n",
        "    ('Kochi', '2024-02', 135000),\n",
        "    ('Kochi', '2024-03', 128000),\n",
        "    ('Kochi', '2024-04', 150000),\n",
        "\n",
        "    ('Chennai', '2024-01', 110000),\n",
        "    ('Chennai', '2024-02', 125000),\n",
        "    ('Chennai', '2024-03', 140000),\n",
        "    ('Chennai', '2024-04', 138000),\n",
        "\n",
        "    ('Bangalore', '2024-01', 150000),\n",
        "    ('Bangalore', '2024-02', 155000),\n",
        "    ('Bangalore', '2024-03', 149000),\n",
        "    ('Bangalore', '2024-04', 165000),\n",
        "\n",
        "    ('Hyderabad', '2024-01', 90000),\n",
        "    ('Hyderabad', '2024-02', 105000),\n",
        "    ('Hyderabad', '2024-03', 112000),\n",
        "    ('Hyderabad', '2024-04', 125000),\n",
        "\n",
        "    ('Delhi', '2024-01', 180000),\n",
        "    ('Delhi', '2024-02', 175000),\n",
        "    ('Delhi', '2024-03', 190000),\n",
        "    ('Delhi', '2024-04', 210000)\n",
        "    AS sales(city, month, sales_amount)\n",
        "),\n",
        "\n",
        "sales_analysis AS (\n",
        "    SELECT\n",
        "        city,\n",
        "        month,\n",
        "        sales_amount,\n",
        "\n",
        "        LAG(sales_amount) OVER (\n",
        "            PARTITION BY city\n",
        "            ORDER BY month\n",
        "        ) AS previous_sales,\n",
        "\n",
        "        sales_amount -\n",
        "        LAG(sales_amount) OVER (\n",
        "            PARTITION BY city\n",
        "            ORDER BY month\n",
        "        ) AS sales_difference,\n",
        "\n",
        "        ROUND(\n",
        "            (\n",
        "                sales_amount -\n",
        "                LAG(sales_amount) OVER (\n",
        "                    PARTITION BY city\n",
        "                    ORDER BY month\n",
        "                )\n",
        "            ) * 100.0\n",
        "            /\n",
        "            LAG(sales_amount) OVER (\n",
        "                PARTITION BY city\n",
        "                ORDER BY month\n",
        "            ),\n",
        "            2\n",
        "        ) AS growth_percentage,\n",
        "\n",
        "        SUM(sales_amount) OVER (\n",
        "            PARTITION BY city\n",
        "            ORDER BY month\n",
        "            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n",
        "        ) AS running_total\n",
        "\n",
        "    FROM sales\n",
        ")\n",
        "SELECT *\n",
        "FROM sales_analysis\n",
        "ORDER BY city, month;"
      ]
    }
  ],
